# Terraform working directory and downloaded providers
**/.terraform/*

# Terraform state (may contain sensitive values)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files
*.tfplan
*.plan

# Variable files may contain credentials or sensitive values
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local environment / credentials
.env
.env.*
.aws/
credentials
*.pem
*.key

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# NOTE:
# Keep .terraform.lock.hcl committed for reproducible provider selection.
